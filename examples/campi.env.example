# Optional systemd EnvironmentFile overrides, not a shell script.
# Defaults already match the original CamPi Pi 5 build.
# All GPIO values are BCM numbers, NOT physical header pin numbers.
# Uncomment only values that differ from your hardware.

# CAMPI_SPI_PORT=0
# CAMPI_LCD_SPI_DEVICE=0
# CAMPI_TOUCH_SPI_DEVICE=1
# CAMPI_LCD_DC=22
# CAMPI_LCD_RST=27
# CAMPI_TOUCH_IRQ_GPIO=17
# CAMPI_BUZZER_GPIO=16
# CAMPI_LCD_SPI_SPEED=32000000
# CAMPI_TOUCH_SPI_SPEED=1000000
# CAMPI_LCD_ROTATION=0

# CAMPI_HOME=/home/youruser
# CAMPI_CONFIG_DIR=/home/youruser/.config/tapeless
# CAMPI_INTERNAL_CAPTURE_DIR=/home/youruser/captures
# CAMPI_USB_CAPTURE_DIR=/mnt/usb-captures
# CAMPI_STATUS_FONT=/home/youruser/fonts/sonycam-original.otf

# Fallbacks are only used if automatic device discovery fails.
# CAMPI_ANALOG_VIDEO_FALLBACK=/dev/video0
# CAMPI_ANALOG_AUDIO_FALLBACK=plughw:2,0

# HDMI framebuffer fallback geometry; the actual DRM/mode behaviour still
# depends on mpv and the connected display.
# CAMPI_HDMI_FB=/dev/fb0
# CAMPI_HDMI_WIDTH=1920
# CAMPI_HDMI_HEIGHT=1080
